{
  "manifest_version": 3,
  "name": "AI Wellbeing Buffer",
  "short_name": "WellbeingBuffer",
  "version": "1.0.0",
  "description": "Blurs toxic/NSFW/triggering content before it renders, checks your posts before you send them, and tracks your mood impact — using locally-hosted, self-trained ML models.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "http://localhost:8000/*",
    "*://*.twitter.com/*",
    "*://*.x.com/*",
    "*://*.reddit.com/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Wellbeing Buffer"
  }
}

